# Copy to .env and fill in. Never commit .env or firebase-service-account.json.

MONGODB_URI=mongodb://localhost:27017/callmonitor
API_KEY=change-this-key
PORT=3000

# Public URLs returned at enrollment
# SERVER_URL = Express device API base (Android call/GPS uploads)
# NEXT_URL   = Next.js fleet site (expense Custom Tab + webhooks)
# SERVER_URL=https://your-express.vercel.app
# NEXT_URL=https://your-fleet.vercel.app

# FCM wake: paste the full service account JSON as a single line (same as Firebase Console → Service accounts → key).
# Or leave unset and place firebase-service-account.json in this folder (gitignored).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
